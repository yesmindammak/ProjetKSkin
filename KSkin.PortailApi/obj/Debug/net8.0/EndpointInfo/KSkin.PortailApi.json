{
  "openapi": "3.0.1",
  "info": {
    "title": "KSkin.PortailApi",
    "version": "1.0"
  },
  "paths": {
    "/api/contacts/by-phone": {
      "get": {
        "tags": [
          "Contacts"
        ],
        "parameters": [
          {
            "name": "telephone",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/demandes": {
      "post": {
        "tags": [
          "Demandes"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreerDemandeRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CreerDemandeRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CreerDemandeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/points-de-vente": {
      "get": {
        "tags": [
          "PointsDeVente"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/produits": {
      "get": {
        "tags": [
          "Produits"
        ],
        "parameters": [
          {
            "name": "marque",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "categorie",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/produits/{id}": {
      "get": {
        "tags": [
          "Produits"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/produits/marques": {
      "get": {
        "tags": [
          "Produits"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/produits/marques-details": {
      "get": {
        "tags": [
          "Produits"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/produits/categories": {
      "get": {
        "tags": [
          "Produits"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreerDemandeRequest": {
        "required": [
          "items",
          "modeLivraison",
          "modePaiement",
          "nom",
          "prenom",
          "telephone"
        ],
        "type": "object",
        "properties": {
          "nom": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "prenom": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "telephone": {
            "maxLength": 30,
            "minLength": 0,
            "type": "string"
          },
          "email": {
            "maxLength": 150,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "gouvernorat": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "ville": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "adresse": {
            "maxLength": 250,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "modeLivraison": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "modePaiement": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "pointDeVenteId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "items": {
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DemandeItemRequest"
            }
          },
          "origine": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "DemandeItemRequest": {
        "type": "object",
        "properties": {
          "produitId": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "quantite": {
            "maximum": 10000,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      }
    }
  }
}