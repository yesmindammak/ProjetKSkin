<Window x:Class="LoginRegisterApp.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Account" Height="680" Width="380"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6FA"
        ResizeMode="NoResize">

    <Grid>
        <Border Background="White" CornerRadius="10" Margin="25"
                Padding="30" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.15"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="Create an account" FontSize="22" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <TextBlock Text="Full name" FontSize="12" Foreground="#555" Margin="0,0,0,4"/>
                <TextBox x:Name="NameBox" Style="{StaticResource InputBox}"/>

                <TextBlock Text="Username" FontSize="12" Foreground="#555" Margin="0,0,0,4"/>
                <TextBox x:Name="UsernameBox" Style="{StaticResource InputBox}"/>

                <TextBlock Text="Email" FontSize="12" Foreground="#555" Margin="0,0,0,4"/>
                <TextBox x:Name="EmailBox" Style="{StaticResource InputBox}"/>

                <TextBlock Text="Phone number" FontSize="12" Foreground="#555" Margin="0,0,0,4"/>
                <TextBox x:Name="PhoneBox" Style="{StaticResource InputBox}"/>

                <TextBlock Text="Password (leave blank to auto-generate one)" FontSize="12"
                           Foreground="#555" Margin="0,0,0,4" TextWrapping="Wrap"/>
                <PasswordBox x:Name="PasswordBox" Style="{StaticResource InputPasswordBox}"/>

                <TextBlock x:Name="ErrorText" Foreground="Red" FontSize="12"
                           TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed"/>

                <Button Content="Register" Style="{StaticResource PrimaryButton}"
                        Click="RegisterButton_Click"/>

                <Button Content="Already have an account? Log in"
                        Style="{StaticResource LinkButton}"
                        HorizontalAlignment="Center" Margin="0,16,0,0"
                        Click="GoToLogin_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
