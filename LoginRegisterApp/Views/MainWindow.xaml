<Window x:Class="LoginRegisterApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:LoginRegisterApp.Converters"
        Title="KSkin Beauty - Skincare &amp; Management" Height="680" Width="1180" MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <conv:StatutActivationToBoolConverter x:Key="ActivationToBool"/>
        <conv:StatutValidationToBoolConverter x:Key="ValidationToBool"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <!-- ROOT GRID: NO SIDEBAR, TOP NAVIGATION BAR, OVERLAY MODALS AT THE END -->
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Bar & Header -->
            <RowDefinition Height="*"/>    <!-- Main View Content -->
        </Grid.RowDefinitions>

        <!-- ==================== TOP NAVIGATION HEADER (YESSTYLE STYLE) ==================== -->
        <Border Grid.Row="0" Background="{StaticResource CardBrush}" BorderBrush="#E9ECEF" BorderThickness="0,0,0,1" Padding="20,10">
            <StackPanel>
                <!-- Top Row: Logo, Nav Buttons, Search Box, Profile Actions in a clean DockPanel (Zero Overlap!) -->
                <DockPanel LastChildFill="False" Margin="0,0,0,8">
                    <!-- Left Side: Logo + Navigation Action Buttons -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Logo -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="Logo_Click" Margin="0,0,16,0">
                            <TextBlock Text="KSkin" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                            <TextBlock Text=" BEAUTY" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AccentGoldBrush}"/>
                        </StackPanel>

                        <!-- Navigation Toggle Buttons -->
                        <ToggleButton x:Name="NavDashboard" Content="🏠 Dashboard" Style="{StaticResource TopNavButtonStyle}"
                                      IsChecked="True" Click="Nav_Click" Margin="0,0,4,0"/>

                        <ToggleButton x:Name="NavCatalogue" Content="🧴 Catalogue" Style="{StaticResource TopNavButtonStyle}"
                                      Click="Nav_Click" Margin="0,0,4,0"/>

                        <!-- Demandes d'achat (Hidden for Admin!) -->
                        <ToggleButton x:Name="NavDemandes" Content="🧾 Demandes" Style="{StaticResource TopNavButtonStyle}"
                                      Click="Nav_Click" Margin="0,0,4,0"/>

                        <ToggleButton x:Name="NavNotifications" Content="🔔 Notifications" Style="{StaticResource TopNavButtonStyle}"
                                      Click="Nav_Click" Margin="0,0,4,0"/>

                        <!-- Utilisateurs & Config (Visible ONLY for Admin!) -->
                        <ToggleButton x:Name="NavUsers" Content="👤 Utilisateurs" Style="{StaticResource TopNavButtonStyle}"
                                      Visibility="Collapsed" Click="Nav_Click" Margin="0,0,4,0"/>
                    </StackPanel>

                    <!-- Right Side: Search Box + Profile Actions -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Compact Search Input Box -->
                        <Border Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="18" Padding="10,4" Width="160" Margin="0,0,10,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🔍 " FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                         FontSize="11" TextChanged="SearchBox_TextChanged" VerticalAlignment="Center"
                                         ToolTip="Rechercher un produit, ingrédient, marque..."/>
                            </Grid>
                        </Border>

                        <!-- Quick + Demande Button (Hidden for Admin!) -->
                        <Button x:Name="TopNewDemandeBtn" Content="🛒 + Demande" Style="{StaticResource PrimaryButtonStyle}"
                                Padding="8,4" FontSize="11" Margin="0,0,6,0" Click="NewDemandeButton_Click"/>

                        <!-- Role Badge -->
                        <Border x:Name="RoleBadge" CornerRadius="14" Padding="8,3" Background="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0">
                            <TextBlock x:Name="RoleBadgeText" Text="Utilisateur" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                        </Border>

                        <Button x:Name="LogoutButton" Content="Déconnexion" Style="{StaticResource OutlineButtonStyle}"
                                Foreground="{StaticResource PrimaryBrush}" Padding="8,4" FontSize="11" Click="LogoutButton_Click"/>
                    </StackPanel>
                </DockPanel>

                <!-- Second Row: Horizontal Category Bar -->
                <Border Height="1" Background="#F0F0F0" Margin="0,0,0,6"/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <WrapPanel x:Name="CategoryBarPanel" VerticalAlignment="Center">
                        <Button x:Name="CatAllBtn" Content="TOUS PRODUITS" Style="{StaticResource OutlineButtonStyle}"
                                Foreground="{StaticResource PrimaryDarkBrush}" Margin="0,0,10,0" Click="CategoryFilter_Click" Tag=""/>
                        <Button x:Name="CatCleanserBtn" Content="NETTOYANTS" Style="{StaticResource OutlineButtonStyle}"
                                Foreground="{StaticResource TextDarkBrush}" Margin="0,0,10,0" Click="CategoryFilter_Click" Tag="Nettoyant"/>
                        <Button x:Name="CatSerumBtn" Content="SÉRUMS" Style="{StaticResource OutlineButtonStyle}"
                                Foreground="{StaticResource TextDarkBrush}" Margin="0,0,10,0" Click="CategoryFilter_Click" Tag="Sérum"/>
                        <Button x:Name="CatMoisturizerBtn" Content="HYDRATANTS" Style="{StaticResource OutlineButtonStyle}"
                                Foreground="{StaticResource TextDarkBrush}" Margin="0,0,10,0" Click="CategoryFilter_Click" Tag="Crème"/>
                        <Button x:Name="CatSunBtn" Content="SOLAIRES &amp; SOINS" Style="{StaticResource OutlineButtonStyle}"
                                Foreground="{StaticResource TextDarkBrush}" Margin="0,0,10,0" Click="CategoryFilter_Click" Tag="Solaire"/>
                    </WrapPanel>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- ==================== MAIN CONTENT CONTAINER ==================== -->
        <Grid Grid.Row="1" Margin="24,16,24,16">

            <!-- 1. DASHBOARD PANEL (ENLARGED BRAND CARDS & METRICS) -->
            <ScrollViewer x:Name="DashboardPanel" Visibility="Visible" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    
                    <!-- Welcome Subtitle -->
                    <Grid Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock x:Name="WelcomeText" Text="Bienvenue sur KSkin Beauty 👋" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}"/>
                            <TextBlock x:Name="SubtitleText" Text="Découvrez nos marques partenaires K-Beauty et parcourez les produits." FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- MARQUES SHOWCASE HEADER (ENLARGED PICTURES) -->
                    <Border Style="{StaticResource StatCardStyle}" Padding="20" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="🏷️ Nos Marques Partenaires K-Beauty" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" Margin="0,0,0,6"/>
                            <TextBlock Text="Cliquez sur une marque pour découvrir tous ses produits." Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,14"/>

                            <!-- Empty DB Warning message if no brands exist yet in DB -->
                            <TextBlock x:Name="NoMarqueWarningText" Visibility="Collapsed"
                                       Text="Aucune marque n'est encore enregistrée dans la base de données. Ajoutez des marques via SSMS pour les voir ici."
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="13" FontStyle="Italic" Margin="0,10,0,10"/>

                            <!-- Strictly populated from Database rows with ENLARGED Pictures -->
                            <ItemsControl x:Name="MarquesItemsControl">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource InteractiveBrandCardStyle}" Width="230" Height="200" Margin="0,0,16,16" Cursor="Hand"
                                                MouseLeftButtonDown="BrandCard_Click" Tag="{Binding Nom}">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <Border CornerRadius="10" ClipToBounds="True" Height="135" Width="205" Background="{StaticResource BlushBrush}" Margin="0,0,0,8">
                                                    <Image Source="{Binding ImageUrl}" Stretch="UniformToFill"/>
                                                </Border>
                                                <TextBlock Text="{Binding Nom}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- METRICS RIBBON -->
                    <UniformGrid Rows="1" Columns="3" Margin="0,0,0,18">
                        <Border Style="{StaticResource StatCardStyle}" Padding="16,12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🧴 " FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <StackPanel>
                                    <TextBlock Text="Catalogue" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock x:Name="StatProduitsCount" Text="0 produits" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatCardStyle}" Padding="16,12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🧾 " FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <StackPanel>
                                    <TextBlock Text="Demandes d'achat" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock x:Name="StatDemandesCount" Text="0 demandes" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatCardStyle}" Padding="16,12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👥 " FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <StackPanel>
                                    <TextBlock Text="Contacts clients" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock x:Name="StatContactsCount" Text="0 contacts" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- RECENT NOTIFICATION SNIPPET -->
                    <Border Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <TextBlock Text="📢 Dernières Notifications" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" Margin="0,0,0,6"/>
                            <TextBlock x:Name="DashboardNotifText" Text="Aucune notification récente." Foreground="{StaticResource TextMutedBrush}" FontSize="13"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- 2. CATALOGUE PANEL -->
            <Grid x:Name="CataloguePanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock x:Name="CatalogueTitleText" Text="Catalogue complet des produits" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource TextDarkBrush}" VerticalAlignment="Center"/>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ProduitsItemsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource InteractiveProductCardStyle}" Width="250" Margin="0,0,16,16">
                                    <StackPanel>
                                        <Border CornerRadius="12" ClipToBounds="True" Height="175" Background="{StaticResource BlushBrush}" Cursor="Hand"
                                                MouseLeftButtonDown="ProductCard_Click">
                                            <Image Source="{Binding ImageUrl}" Stretch="UniformToFill"/>
                                        </Border>
                                        <TextBlock Text="{Binding Nom}" FontWeight="Bold" FontSize="14" Margin="0,10,0,2"
                                                   TextWrapping="Wrap" Foreground="{StaticResource TextDarkBrush}" Cursor="Hand"
                                                   MouseLeftButtonDown="ProductCard_Click"/>
                                        <Grid Margin="0,4,0,8">
                                            <TextBlock Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold" FontSize="15">
                                                <Run Text="{Binding Prix, Mode=OneWay, StringFormat={}{0:0.00} DT}"/>
                                            </TextBlock>
                                            <Border HorizontalAlignment="Right" Background="#F3DED2" CornerRadius="6" Padding="6,2">
                                                <TextBlock Foreground="{StaticResource TextDarkBrush}" FontSize="11" FontWeight="SemiBold">
                                                    <Run Text="Stock: "/><Run Text="{Binding Stock, Mode=OneWay}"/>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="👁️ Détails" Style="{StaticResource OutlineButtonStyle}"
                                                    Padding="8,5" FontSize="11" Foreground="{StaticResource TextDarkBrush}"
                                                    Click="ViewDetailsButton_Click" Tag="{Binding ProduitId}"/>
                                            <Button Grid.Column="1" Content="🛒 + Demande" Style="{StaticResource PrimaryButtonStyle}"
                                                    Padding="10,5" FontSize="11" Margin="6,0,0,0"
                                                    Click="QuickOrderButton_Click" Tag="{Binding ProduitId}"
                                                    Visibility="{Binding CanCreateDemande, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- 3. DEMANDES PANEL (Hidden for Admin!) -->
            <Grid x:Name="DemandesPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock Grid.Column="0" Text="Gestion des demandes d'achat" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource TextDarkBrush}" VerticalAlignment="Center"/>
                </Grid>

                <Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="14" Padding="4">
                    <DataGrid x:Name="DemandesGrid" Style="{StaticResource ThemedDataGridStyle}" HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding DemandeId}" Width="40"/>
                            <DataGridTextColumn Header="Client (Contact)" Binding="{Binding ContactNom}" Width="150"/>
                            <DataGridTextColumn Header="Produit" Binding="{Binding ProduitNom}" Width="140"/>
                            <DataGridTextColumn Header="Magasin / Pdv" Binding="{Binding PointDeVenteNom}" Width="130"/>
                            <DataGridTextColumn Header="Qté" Binding="{Binding Quantite}" Width="40"/>
                            <DataGridTextColumn Header="Total (DT)" Binding="{Binding TotalPrix, StringFormat={}{0:0.00}}" Width="75"/>
                            <DataGridTextColumn Header="Livraison" Binding="{Binding ModeLivraison}" Width="110"/>
                            <DataGridTextColumn Header="Paiement" Binding="{Binding ModePaiement}" Width="110"/>
                            <DataGridTextColumn Header="Statut" Binding="{Binding Statut}" Width="85"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding DateDemande, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="110"/>
                            
                            <DataGridTemplateColumn Header="Actions" Width="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="Valider" Margin="2,0" Padding="8,4" FontSize="11"
                                                    Background="#2E7D32" Foreground="White" BorderThickness="0"
                                                    Click="ValiderDemande_Click" Tag="{Binding DemandeId}"
                                                    Visibility="{Binding CanBeValidatedOrRefused, Converter={StaticResource BoolToVis}}"/>
                                            
                                            <Button Content="Refuser" Margin="2,0" Padding="8,4" FontSize="11"
                                                    Background="{StaticResource DangerBrush}" Foreground="White" BorderThickness="0"
                                                    Click="RefuserDemande_Click" Tag="{Binding DemandeId}"
                                                    Visibility="{Binding CanBeValidatedOrRefused, Converter={StaticResource BoolToVis}}"/>
                                            
                                            <Button Content="Clôturer" Margin="2,0" Padding="8,4" FontSize="11"
                                                    Background="{StaticResource PrimaryBrush}" Foreground="White" BorderThickness="0"
                                                    Click="CloturerDemande_Click" Tag="{Binding DemandeId}"
                                                    Visibility="{Binding CanBeClosed, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <!-- 4. NOTIFICATIONS PANEL -->
            <Grid x:Name="NotificationsPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Centre de notifications" FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource TextDarkBrush}" Margin="0,0,0,14"/>

                <Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="14" Padding="4">
                    <DataGrid x:Name="NotificationsGrid" Style="{StaticResource ThemedDataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding DateEnvoi, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="140"/>
                            <DataGridTextColumn Header="Expéditeur" Binding="{Binding Expediteur}" Width="130"/>
                            <DataGridTextColumn Header="Objet" Binding="{Binding Objet}" Width="220"/>
                            <DataGridTextColumn Header="Contenu" Binding="{Binding Contenu}" Width="*"/>
                            <DataGridTemplateColumn Header="Action" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Marquer lu" Padding="6,3" FontSize="11"
                                                Style="{StaticResource OutlineButtonStyle}" Foreground="{StaticResource PrimaryBrush}"
                                                Click="MarkNotificationRead_Click" Tag="{Binding NotificationId}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <!-- 5. USERS & CONFIG PANEL (ADMIN ONLY) -->
            <ScrollViewer x:Name="UsersPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Section A: User Management -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Gestion des utilisateurs" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource TextDarkBrush}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="+ Nouvel utilisateur" Style="{StaticResource PrimaryButtonStyle}"
                                Click="NewUserButton_Click"/>
                    </Grid>

                    <Border Background="{StaticResource CardBrush}" CornerRadius="14" Padding="4" Height="260">
                        <DataGrid x:Name="UsersGrid" Style="{StaticResource ThemedDataGridStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="130"/>
                                <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="140"/>
                                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="180"/>
                                <DataGridTextColumn Header="Téléphone" Binding="{Binding PhoneNumber}" Width="120"/>
                                <DataGridTextColumn Header="Rôle" Binding="{Binding Role}" Width="110"/>

                                <DataGridTemplateColumn Header="Actif" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ToggleButton Style="{StaticResource SwitchToggleStyle}" HorizontalAlignment="Center"
                                                          IsChecked="{Binding StatutActivation, Converter={StaticResource ActivationToBool}, Mode=OneWay}"
                                                          Click="ActivationToggle_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Validé" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ToggleButton Style="{StaticResource SwitchToggleStyle}" HorizontalAlignment="Center"
                                                          IsChecked="{Binding StatutValidation, Converter={StaticResource ValidationToBool}, Mode=OneWay}"
                                                          Click="ValidationToggle_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Section B: Paramétrage Expiration Mots de Passe -->
                    <Border Style="{StaticResource StatCardStyle}" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="⚙️ Paramétrage de la durée d'expiration des mots de passe" FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource TextDarkBrush}" Margin="0,0,0,8"/>
                            <TextBlock Text="Définissez la durée (en jours) après laquelle le mot de passe d'un utilisateur expire et est automatiquement renouvelé."
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="13" Margin="0,0,0,14"/>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Durée actuelle : " FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock x:Name="CurrentExpirationDaysText" Text="90 jours" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <TextBlock Text="Nouvelle durée (jours) : " VerticalAlignment="Center" FontSize="13" Margin="0,0,8,0"/>
                                <TextBox x:Name="ExpirationDaysInput" Width="100" Style="{StaticResource InputBox}" Margin="0,0,16,0" Text="90"/>
                                <Button Content="Enregistrer la règle" Style="{StaticResource PrimaryButtonStyle}" Click="SaveExpirationDays_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

        </Grid>

        <!-- ==================== ROOT LEVEL MODAL OVERLAYS (100% Z-INDEX FIX) ==================== -->
        
        <!-- MODAL OVERLAY 1: PRODUCT DETAILS MODAL (WITH POINT DE VENTE AVAILABILITY SECTION!) -->
        <Grid x:Name="ProductDetailModal" Grid.RowSpan="2" Panel.ZIndex="1000" Background="#A0000000" Visibility="Collapsed">
            <Border Background="White" CornerRadius="16" Width="680" Height="560" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" Content="✕" HorizontalAlignment="Right" Background="Transparent"
                            BorderThickness="0" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"
                            Cursor="Hand" Click="CloseProductDetail_Click"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Product Image -->
                            <Border Grid.Column="0" CornerRadius="12" ClipToBounds="True" Height="240" Background="{StaticResource BlushBrush}" VerticalAlignment="Top">
                                <Image x:Name="DetailProductImage" Stretch="UniformToFill"/>
                            </Border>

                            <!-- Right: Product Info + Point de Vente Availability Section -->
                            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                <TextBlock x:Name="DetailProductName" Text="Nom du produit" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" TextWrapping="Wrap"/>
                                
                                <TextBlock Foreground="{StaticResource PrimaryBrush}" FontSize="16" FontWeight="Bold" Margin="0,4,0,0">
                                    <Run x:Name="DetailProductPrice" Text="0.00 DT"/>
                                </TextBlock>

                                <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,4,0,8">
                                    Stock disponible global : <Run x:Name="DetailProductStock" Text="0" FontWeight="Bold"/>
                                </TextBlock>

                                <Border Height="1" Background="#E0E0E0" Margin="0,4,0,10"/>

                                <TextBlock Text="Description :" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextDarkBrush}"/>
                                <TextBlock x:Name="DetailProductDescription" Text="Description..." FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,3,0,10"/>

                                <TextBlock Text="Ingrédients :" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextDarkBrush}"/>
                                <TextBlock x:Name="DetailProductIngredients" Text="Ingrédients..." FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,3,0,12"/>

                                <!-- ==================== DISPONIBILITÉ PAR POINT DE VENTE (LIKE REFERENCE DESIGN) ==================== -->
                                <Border Background="#F9F6F3" BorderBrush="#EADECF" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,4,0,0">
                                    <StackPanel>
                                        <Border Background="#EFE5DC" CornerRadius="6" Padding="8,4" Margin="0,0,0,8">
                                            <TextBlock Text="📍 Disponibilité par Point de Vente" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextDarkBrush}" HorizontalAlignment="Center"/>
                                        </Border>

                                        <ItemsControl x:Name="PointDeVenteItemsControl">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3,0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0" Text="{Binding PointDeVenteNom}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextDarkBrush}" VerticalAlignment="Center"/>

                                                        <Border Grid.Column="1" CornerRadius="4" Padding="6,2" Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="1">
                                                            <TextBlock Text="{Binding StatutDisponibilite}" FontSize="11" FontWeight="Bold" Foreground="{Binding BadgeColorHex}"/>
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <Button x:Name="ModalOrderButton" Grid.Row="2" Content="+ Créer une demande d'achat pour ce produit"
                            Style="{StaticResource PrimaryButtonStyle}" Click="OrderThisProduct_Click"/>
                </Grid>
            </Border>
        </Grid>

        <!-- MODAL OVERLAY 2: NEW DEMANDE D'ACHAT FORM (WITH DELIVERY & PAYMENT OPTIONS!) -->
        <Grid x:Name="NewDemandeModal" Grid.RowSpan="2" Panel.ZIndex="1000" Background="#A0000000" Visibility="Collapsed">
            <Border Background="White" CornerRadius="16" Width="520" Height="560" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Nouvelle Demande d'Achat" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}"/>
                            <Button Content="✕" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0"
                                    FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Cursor="Hand"
                                    Click="CloseNewDemandeModal_Click"/>
                        </Grid>

                        <TextBlock Text="Sélectionner le produit :" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox x:Name="DemandeProduitCombo" DisplayMemberPath="Nom" SelectedValuePath="ProduitId" Height="34" Margin="0,0,0,10"/>

                        <TextBlock Text="Quantité souhaitée :" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="DemandeQuantiteBox" Style="{StaticResource InputBox}" Text="1"/>

                        <!-- Delivery & Payment Selection -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Mode de livraison :" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ComboBox x:Name="DemandeLivraisonCombo" Height="34" SelectionChanged="DemandeLivraisonCombo_SelectionChanged">
                                    <ComboBoxItem Content="Livraison à Domicile" IsSelected="True"/>
                                    <ComboBoxItem Content="Retrait en Magasin (Click &amp; Collect)"/>
                                    <ComboBoxItem Content="Expédition Express 24h"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Mode de paiement :" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ComboBox x:Name="DemandePaiementCombo" Height="34">
                                    <ComboBoxItem Content="Paiement à la Livraison" IsSelected="True"/>
                                    <ComboBoxItem Content="Carte Bancaire en Ligne"/>
                                    <ComboBoxItem Content="Virement Bancaire"/>
                                    <ComboBoxItem Content="Chèque à la Livraison"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="DemandePdvLabel" Text="Point de Vente (Magasin expéditeur / retrait) :" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox x:Name="DemandePdvCombo" DisplayMemberPath="Nom" SelectedValuePath="PointDeVenteId" Height="34" Margin="0,0,0,10"/>

                        <TextBlock Text="Information du Client Final (Contact)" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,4,0,4"/>
                        <TextBlock x:Name="ClientInfoBadgeText" Text="Entrez un téléphone ou nom pour rechercher un contact existant." FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>

                        <TextBlock Text="Téléphone :" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="ClientPhoneBox" Style="{StaticResource InputBox}" LostFocus="ClientContactInput_Changed" TextChanged="ClientContactInput_Changed"/>

                        <TextBlock Text="Nom :" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="ClientNomBox" Style="{StaticResource InputBox}" LostFocus="ClientContactInput_Changed"/>

                        <TextBlock Text="Prénom :" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="ClientPrenomBox" Style="{StaticResource InputBox}" LostFocus="ClientContactInput_Changed"/>

                        <TextBlock Text="Email :" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="ClientEmailBox" Style="{StaticResource InputBox}"/>

                        <!-- Location Breakdown (Matching User Reference Image) -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Gouvernorat / Région :" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ComboBox x:Name="ClientGouvernoratCombo" Height="34" SelectionChanged="ClientLocation_Changed">
                                    <ComboBoxItem Content="Tunis" IsSelected="True"/>
                                    <ComboBoxItem Content="Ariana"/>
                                    <ComboBoxItem Content="Ben Arous"/>
                                    <ComboBoxItem Content="Manouba"/>
                                    <ComboBoxItem Content="Nabeul"/>
                                    <ComboBoxItem Content="Bizerte"/>
                                    <ComboBoxItem Content="Sousse"/>
                                    <ComboBoxItem Content="Monastir"/>
                                    <ComboBoxItem Content="Sfax"/>
                                    <ComboBoxItem Content="Kairouan"/>
                                    <ComboBoxItem Content="Béja"/>
                                    <ComboBoxItem Content="Autre / International"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Ville / Cité :" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox x:Name="ClientVilleBox" Style="{StaticResource InputBox}" TextChanged="ClientLocation_Changed"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Adresse exacte (Rue, Numéro...) :" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="ClientAdresseBox" Style="{StaticResource InputBox}"/>

                        <TextBlock x:Name="DemandeErrorText" Foreground="{StaticResource DangerBrush}" FontSize="12" Visibility="Collapsed" Margin="0,0,0,10" TextWrapping="Wrap"/>

                        <Button Content="Soumettre la demande d'achat" Style="{StaticResource PrimaryButtonStyle}" Click="SubmitDemande_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

    </Grid>
</Window>
