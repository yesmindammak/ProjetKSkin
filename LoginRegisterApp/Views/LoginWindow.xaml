<Window x:Class="LoginRegisterApp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign In" Height="480" Width="380"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6FA"
        ResizeMode="NoResize">

    <Grid>
        <Border Background="White" CornerRadius="10" Margin="25"
                Padding="30" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.15"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="Welcome back" FontSize="22" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Text="Sign in to continue" FontSize="13" Foreground="#888"
                           HorizontalAlignment="Center" Margin="0,0,0,24"/>

                <TextBlock Text="Username" FontSize="12" Foreground="#555" Margin="0,0,0,4"/>
                <TextBox x:Name="UsernameBox" Style="{StaticResource InputBox}"/>

                <TextBlock Text="Password" FontSize="12" Foreground="#555" Margin="0,0,0,4"/>
                <PasswordBox x:Name="PasswordBox" Style="{StaticResource InputPasswordBox}"/>

                <TextBlock x:Name="ErrorText" Foreground="Red" FontSize="12"
                           TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed"/>

                <Button Content="Log In" Style="{StaticResource PrimaryButton}"
                        Click="LoginButton_Click"/>

                <Button Content="Don't have an account? Register"
                        Style="{StaticResource LinkButton}"
                        HorizontalAlignment="Center" Margin="0,16,0,0"
                        Click="GoToRegister_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
