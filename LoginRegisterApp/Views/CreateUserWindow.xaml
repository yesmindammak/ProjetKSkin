<Window x:Class="LoginRegisterApp.CreateUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nouvel utilisateur" Height="569" Width="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">
    <StackPanel Margin="28">
        <TextBlock Text="Créer un utilisateur" FontSize="18" FontWeight="Bold"
                   Foreground="{StaticResource TextDarkBrush}" Margin="0,0,0,4"/>
        <TextBlock Text="Le compte est créé Actif et Validé directement (5.1)."
                   FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,16"/>

        <TextBlock Text="Nom complet" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
        <TextBox x:Name="NameBox" Style="{StaticResource InputBox}"/>

        <TextBlock Text="Nom d'utilisateur" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
        <TextBox x:Name="UsernameBox" Style="{StaticResource InputBox}"/>

        <TextBlock Text="Email" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
        <TextBox x:Name="EmailBox" Style="{StaticResource InputBox}"/>

        <TextBlock Text="Téléphone" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
        <TextBox x:Name="PhoneBox" Style="{StaticResource InputBox}"/>

        <TextBlock Text="Rôle" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
        <ComboBox x:Name="RoleCombo" Margin="0,0,0,16" Padding="10,8" SelectedIndex="0">
            <ComboBoxItem Content="Client (utilisateur commercial)" Tag="Client"/>
            <ComboBoxItem Content="Superviseur d'achat" Tag="SuperviseurAchat"/>
            <ComboBoxItem Content="Administrateur" Tag="Admin"/>
        </ComboBox>

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" FontSize="12"
                   TextWrapping="Wrap" Margin="0,0,0,12" Visibility="Collapsed"/>

        <Button Content="Créer le compte" Style="{StaticResource PrimaryButtonStyle}"
                Click="CreateButton_Click"/>
    </StackPanel>
</Window>
