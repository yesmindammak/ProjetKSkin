<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!-- La base de l'application (comptes, contacts, demandes, notifications, produits). -->
    <add name="KSkinManager"
         connectionString="Server=localhost;Database=WPF;Trusted_Connection=True;TrustServerCertificate=True;"
         providerName="Microsoft.Data.SqlClient" />

    <!-- La base externe (simule le systeme du superviseur de stock). Change le
         Server si elle est hebergee ailleurs - meme instance ici pour simplifier. -->
    <add name="KSkinStockExterne"
         connectionString="Server=localhost;Database=KSkinStockExterne;Trusted_Connection=True;TrustServerCertificate=True;"
         providerName="Microsoft.Data.SqlClient" />
  </connectionStrings>
</configuration>
