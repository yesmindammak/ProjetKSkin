<Window x:Class="LoginRegisterApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KSkin Manager" Height="700" Width="1150"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= SIDEBAR ================= -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <DockPanel LastChildFill="True">

                <!-- Logo / app name -->
                <StackPanel DockPanel.Dock="Top" Margin="22,28,22,26">
                    <TextBlock Text="KSkin" FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource AccentGoldBrush}"/>
                    <TextBlock Text="MANAGER" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextOnDarkBrush}" Opacity="0.8"
                               Margin="0,-2,0,0"/>
                </StackPanel>

                <!-- Logout pinned to the bottom -->
                <StackPanel DockPanel.Dock="Bottom" Margin="16,0,16,24">
                    <Border Height="1" Background="{StaticResource SidebarHoverBrush}" Margin="4,0,4,16"/>
                    <Button x:Name="LogoutButton" Content="Se déconnecter"
                            Style="{StaticResource OutlineButtonStyle}"
                            Click="LogoutButton_Click"/>
                </StackPanel>

                <!-- Nav links -->
                <StackPanel x:Name="NavPanel">
                    <ToggleButton x:Name="NavDashboard" Content="🏠  Tableau de bord"
                                  Style="{StaticResource SidebarNavButtonStyle}"
                                  IsChecked="True" Click="Nav_Click"/>
                    <ToggleButton x:Name="NavCatalogue" Content="🧴  Catalogue produits"
                                  Style="{StaticResource SidebarNavButtonStyle}"
                                  Click="Nav_Click"/>
                    <ToggleButton x:Name="NavDemandes" Content="🧾  Demandes d'achat"
                                  Style="{StaticResource SidebarNavButtonStyle}"
                                  Click="Nav_Click"/>
                    <ToggleButton x:Name="NavUsers" Content="👤  Gestion des utilisateurs"
                                  Style="{StaticResource SidebarNavButtonStyle}"
                                  Visibility="Collapsed" Click="Nav_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= MAIN CONTENT ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header bar -->
            <Border Grid.Row="0" Background="{StaticResource CardBrush}" Padding="32,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="WelcomeText" Text="Bonjour 👋" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource TextDarkBrush}"/>
                        <TextBlock x:Name="SubtitleText" Text="Voici un aperçu de votre activité aujourd'hui."
                                   FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Role badge -->
                    <Border x:Name="RoleBadge" Grid.Column="1" CornerRadius="20" Padding="14,7"
                            Background="{StaticResource PrimaryBrush}" VerticalAlignment="Center">
                        <TextBlock x:Name="RoleBadgeText" Text="Utilisateur" Foreground="White"
                                   FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Content area: only one of these panels is visible at a time -->
            <Grid Grid.Row="1" Margin="32,24,32,24">

                <!-- ---- Dashboard panel ---- -->
                <StackPanel x:Name="DashboardPanel" Visibility="Visible">
                    <UniformGrid Rows="1" Columns="3">
                        <Border Style="{StaticResource StatCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Produits au catalogue" FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="—" FontSize="28" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Demandes en cours" FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="—" FontSize="28" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Mes contacts" FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="—" FontSize="28" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <Border Style="{StaticResource StatCardStyle}" Margin="0,4,16,16">
                        <StackPanel>
                            <TextBlock Text="Bienvenue sur KSkin Manager" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextDarkBrush}"/>
                            <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource TextMutedBrush}"
                                       Text="Utilisez le menu à gauche pour consulter le catalogue, suivre vos demandes d'achat, ou gérer les comptes utilisateurs si vous êtes administrateur."/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ---- Catalogue panel (placeholder) ---- -->
                <Border x:Name="CataloguePanel" Style="{StaticResource StatCardStyle}" Visibility="Collapsed">
                    <TextBlock Text="Le catalogue de produits s'affichera ici." Foreground="{StaticResource TextMutedBrush}"/>
                </Border>

                <!-- ---- Demandes panel (placeholder) ---- -->
                <Border x:Name="DemandesPanel" Style="{StaticResource StatCardStyle}" Visibility="Collapsed">
                    <TextBlock Text="Vos demandes d'achat s'afficheront ici." Foreground="{StaticResource TextMutedBrush}"/>
                </Border>

                <!-- ---- Users panel (admin only) ---- -->
                <Grid x:Name="UsersPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Gestion des utilisateurs" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextDarkBrush}" Margin="0,0,0,12"/>
                    <Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="14" Padding="4">
                        <DataGrid x:Name="UsersGrid" Style="{StaticResource ThemedDataGridStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nom d'utilisateur" Binding="{Binding Username}" Width="150"/>
                                <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="150"/>
                                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="200"/>
                                <DataGridTextColumn Header="Téléphone" Binding="{Binding PhoneNumber}" Width="130"/>
                                <DataGridTextColumn Header="Rôle" Binding="{Binding Role}" Width="90"/>
                                <DataGridTextColumn Header="Statut" Binding="{Binding Status}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>

            </Grid>
        </Grid>
    </Grid>
</Window>
